        "jsCode": "// Turns the signed payload into a short message. Only the minimal fields sent by Convex are used.\nconst b = $input.first().json.body;\nconst when = `${b.startDate} to ${b.endDate}`;\nconst texts = {\n  requested: `${b.otherPartyName} would like to borrow your ${b.toolName} (${when}).`,\n  approved: `${b.otherPartyName} approved your request for the ${b.toolName} (${when}).`,\n  declined: `${b.otherPartyName} declined your request for the ${b.toolName}.`,\n  cancelled: `${b.otherPartyName} cancelled the request for your ${b.toolName}.`,\n  returned: `Your loan of ${b.otherPartyName}'s ${b.toolName} is marked as returned. Thank you!`,\n};\nreturn [{ json: {\n  to: b.recipientEmail,\n  subject: `LendLoop: ${b.event}`,\n  text: `Hi ${b.recipientName}, ${texts[b.event]}`,\n  eventId: $input.first().json.headers['x-lendloop-event-id'],\n} }];"
