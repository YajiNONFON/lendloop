    {
      "parameters": {
        "jsCode": "// One item per overdue loan. Builds the reminder text and the body of the write-back.\nconst today = new Date().toISOString().slice(0, 10);\nreturn $input.all().map((item) => {\n  const l = item.json;\n  const key = `reminder:${l.loanId}:${today}`;\n  const body = JSON.stringify({\n    key, type: 'reminder', status: 'sent', loanId: l.loanId,\n    detail: `Reminder sent to ${l.borrowerName} (${l.daysLate} days late)`,\n  });\n  return { json: {\n    to: l.borrowerEmail,\n    subject: `LendLoop: please return the ${l.toolName}`,\n    text: `Hi ${l.borrowerName}, the ${l.toolName} was due on ${l.endDate} (${l.daysLate} days ago). Please return it soon.`,\n    ts: Date.now(),\n    body,\n  } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "id": "4fa333ba-58cf-4462-864e-2ea0684657aa",
      "name": "Build reminder"
    },
